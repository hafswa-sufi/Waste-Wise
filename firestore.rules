rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'Admin';
    }

    function hasNoPassword() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    function isPartnerRole(role) {
      return role in ['NGO', 'RecyclingFirm'];
    }

    function isApprovedPartnerFor(actionType) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          (
            actionType == 'donation'
            && userDoc(request.auth.uid).data.role == 'NGO'
          ) || (
            actionType == 'disposal'
            && userDoc(request.auth.uid).data.role == 'RecyclingFirm'
          )
        )
        && userDoc(request.auth.uid).data.approvalStatus == 'approved';
    }

    function isApprovedPartnerUserFor(partnerUserId, actionType) {
      return partnerUserId is string
        && exists(/databases/$(database)/documents/users/$(partnerUserId))
        && (
          (
            actionType == 'donation'
            && userDoc(partnerUserId).data.role == 'NGO'
          ) || (
            actionType == 'disposal'
            && userDoc(partnerUserId).data.role == 'RecyclingFirm'
          )
        )
        && userDoc(partnerUserId).data.approvalStatus == 'approved';
    }

    function isValidSignupRole(role) {
      return role in ['Household', 'NGO', 'RecyclingFirm'];
    }

    function validInitialApproval() {
      return (
        request.resource.data.role == 'Household'
        && request.resource.data.approvalStatus == 'approved'
      ) || (
        isPartnerRole(request.resource.data.role)
        && request.resource.data.approvalStatus == 'pending'
      );
    }

    function ownProfileUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'name',
          'email',
          'emailVerified',
          'location',
          'buildingNameNumber',
          'lat',
          'lng',
          'maxPickupRadiusKm',
          'serviceBaseAddress',
          'organizationName',
          'organizationType',
          'registrationNumber',
          'operatingCounties',
          'contactName',
          'designation',
          'certificateFileName',
          'certificateFilePath',
          'certificateFileUrl',
          'certificatePublicId',
          'verificationDocumentStatus',
          'updatedAt'
        ]);
    }

    function adminApprovalUpdateOnly() {
      return isAdmin()
        && isPartnerRole(resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'updatedAt'])
        && request.resource.data.approvalStatus in ['approved', 'rejected'];
    }

    function partnerActionUpdateOnly() {
      return isApprovedPartnerFor(resource.data.type)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'partner',
            'partnerUserId',
            'pickupDate',
            'status',
            'routingStatus',
            'confirmedAt',
            'collectedAt',
            'updatedAt'
          ])
        && request.resource.data.partnerUserId == request.auth.uid
        && request.resource.data.status in ['Confirmed', 'Collected']
        && (
          !('partnerUserId' in resource.data)
          || resource.data.partnerUserId == null
          || resource.data.partnerUserId == request.auth.uid
        );
    }

    function partnerDeclineUpdateOnly() {
      return isApprovedPartnerFor(resource.data.type)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'declinedPartnerIds',
            'partner',
            'partnerUserId',
            'status',
            'routingStatus',
            'updatedAt'
          ])
        && resource.data.partnerUserId == request.auth.uid
        && (
          !('declinedPartnerIds' in resource.data)
          || request.resource.data.declinedPartnerIds
            .hasAll(resource.data.declinedPartnerIds)
        )
        && request.auth.uid in request.resource.data.declinedPartnerIds
        && request.resource.data.status == 'Assigned'
        && isApprovedPartnerUserFor(
          request.resource.data.partnerUserId,
          resource.data.type
        );
    }

    function adminActionAssignmentUpdateOnly() {
      return isAdmin()
        && resource.data.type in ['donation', 'disposal']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'batchId',
            'batchArea',
            'batchAssignedAt',
            'batchRequestCount',
            'partner',
            'partnerUserId',
            'status',
            'updatedAt'
          ])
        && request.resource.data.status == 'Assigned'
        && request.resource.data.batchId is string
        && request.resource.data.batchArea is string
        && request.resource.data.batchRequestCount is number
        && isApprovedPartnerUserFor(
          request.resource.data.partnerUserId,
          resource.data.type
        )
        && (
          !('partnerUserId' in resource.data)
          || resource.data.partnerUserId == null
        )
        && resource.data.status == 'Pending';
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || (
            isPartnerRole(resource.data.role)
            && resource.data.approvalStatus == 'approved'
          )
        );

      allow create: if signedIn()
        && request.auth.uid == userId
        && hasNoPassword()
        && isValidSignupRole(request.resource.data.role)
        && validInitialApproval();

      allow update: if signedIn()
        && hasNoPassword()
        && (
          (request.auth.uid == userId && ownProfileUpdateOnly())
          || adminApprovalUpdateOnly()
        );

      allow delete: if false;

      match /pantryItems/{itemId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }

      match /householdActions/{actionId} {
        allow read, create, update: if signedIn()
          && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /pantryItems/{itemId} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /{path=**}/householdActions/{actionId} {
      allow read: if isAdmin()
        || (
          isApprovedPartnerFor(resource.data.type)
          && resource.data.partnerUserId == request.auth.uid
        );
      allow update: if partnerActionUpdateOnly()
        || partnerDeclineUpdateOnly()
        || adminActionAssignmentUpdateOnly();

      match /statusHistory/{historyId} {
        allow read: if signedIn();
        allow create: if isApprovedPartnerFor(get(/databases/$(database)/documents/$(path)/householdActions/$(actionId)).data.type)
          && request.resource.data.changedByUserId == request.auth.uid;
        allow create: if isAdmin()
          && request.resource.data.changedByUserId == request.auth.uid
          && request.resource.data.changedByRole == 'Admin';
      }
    }

    match /orders/{id} {
      allow read, write: if signedIn();
    }

    match /statusHistories/{id} {
      allow read, write: if signedIn();
    }

    match /freshnessRecords/{id} {
      allow read, write: if signedIn();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn()
        && resource.data.recipientUserId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.recipientUserId == request.auth.uid;
    }
  }
}
