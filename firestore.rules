rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'Admin';
    }

    function hasNoPassword() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    function isPartnerRole(role) {
      return role in ['NGO', 'RecyclingFirm'];
    }

    function isValidSignupRole(role) {
      return role in ['Household', 'NGO', 'RecyclingFirm'];
    }

    function validInitialApproval() {
      return (
        request.resource.data.role == 'Household'
        && request.resource.data.approvalStatus == 'approved'
      ) || (
        isPartnerRole(request.resource.data.role)
        && request.resource.data.approvalStatus == 'pending'
      );
    }

    function ownProfileUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'name',
          'email',
          'emailVerified',
          'location',
          'organizationName',
          'organizationType',
          'registrationNumber',
          'operatingCounties',
          'contactName',
          'designation',
          'certificateFileName',
          'verificationDocumentStatus',
          'updatedAt'
        ]);
    }

    function adminApprovalUpdateOnly() {
      return isAdmin()
        && isPartnerRole(resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'updatedAt'])
        && request.resource.data.approvalStatus in ['approved', 'rejected'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && hasNoPassword()
        && isValidSignupRole(request.resource.data.role)
        && validInitialApproval();

      allow update: if signedIn()
        && hasNoPassword()
        && (
          (request.auth.uid == userId && ownProfileUpdateOnly())
          || adminApprovalUpdateOnly()
        );

      allow delete: if false;

      match /pantryItems/{itemId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }

      match /householdActions/{actionId} {
        allow read, create, update: if signedIn()
          && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /pantryItems/{itemId} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /orders/{id} {
      allow read, write: if signedIn();
    }

    match /statusHistories/{id} {
      allow read, write: if signedIn();
    }

    match /freshnessRecords/{id} {
      allow read, write: if signedIn();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn()
        && resource.data.recipientUserId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.recipientUserId == request.auth.uid;
    }
  }
}
